programa
{
	
	funcao inicio()
	{
		inteiro resposta, contador
		
		para(contador=5; contador>=1; contador++){
			escreva("informe o valor qualquer: ")
			leia(resposta)

			escreva("o quadrado e: ", resposta * resposta)
			escreva("\n")
		}
	}
}
