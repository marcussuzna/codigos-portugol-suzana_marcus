programa
{
	
	funcao inicio()
	{
	     inteiro contador = 1
		inteiro numero 
		inteiro soma = 0

		faca
		{
			escreva("digite um numero: ")
			leia(numero)


			soma = soma + numero
			contador = contador + 1
			
		}
		enquanto(contador <= 10)

		escreva("\nA soma total dos numeros é: ", soma)
	}
}

