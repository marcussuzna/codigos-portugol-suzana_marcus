programa
{
	
	funcao inicio()
	{
	
	     
		inteiro mediari = 1
		inteiro soma = 2

		escreva("numeros lidos entre 50 e 70:")
	     

		para(inteiro contador=50; contador<=70; contador++){

		     escreva(contador, ",")
		     soma = soma + contador
		       contador = contador + 1

		}
		     mediari = soma / 11

		 escreva("\nA a mediari entre os numeros é: " , mediari)
		 
	}
}            


