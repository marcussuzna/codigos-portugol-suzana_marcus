programa
{
	
	funcao inicio()
	{
		inteiro valor, contador
		escreva("Informe um valor: ")
		leia(valor)

		para(contador = 1; contador <= valor; contador++){

			se(valor % contador == 0){1
			
				escreva("\nOs divisores de : ", valor, " são ", contador)
			}
		}
	}
}
