programa
{
	
	funcao inicio()
	{
		inteiro valor

		faca{
			escreva("CADASTRO DE CLIENTE\n\n")
			escreva("1- cadastrar\n")
			escreva("2- atualizar\n")
			escreva("3- ecluir\n")
			escreva("4- consultar\n")
			escreva("5- sair\n")

			escreva("qual opção voce deseja: ")
			leia(valor)
			limpa()
			
		}enquanto(valor != 5)
	}
}
