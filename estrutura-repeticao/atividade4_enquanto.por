programa
{
	
	funcao inicio()
	{
		inteiro numero = 13
		inteiro media = 0
		inteiro soma = 0

		escreva("numeros lidos entre 13 e 73:")

		faca{

		     escreva(numero, ",")
		     soma = soma + numero
		       numero = numero + 1

		}enquanto(numero <= 73)
		     media = soma / 60

		 escreva("\nA média entre os numeros é: " , media)
	}
}            
		 
